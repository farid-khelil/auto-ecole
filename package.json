
{
  "name": "auto-ecole",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^13.5.0",
    "arabic-persian-reshaper": "^1.0.1",
    "better-sqlite3": "^13.0.3",
    "bidi-js": "^1.1.0",
    "docxtemplater": "^3.71.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "pdf-lib": "^1.17.1",
    "pizzip": "^3.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "dev": "vite",
    "dist:linux": "npm run desktop:build && electron-builder --linux",
    "dist:windows": "npm run desktop:build && electron-builder --win",
    "desktop:dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:main\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "tsc --project electron/tsconfig.json --watch",
    "dev:electron": "wait-on tcp:5173 file:dist-electron/main.js && nodemon --watch dist-electron --exec electron .",
    "start": "vite",
    "build": "npm run build:renderer",
    "build:renderer": "vite build",
    "build:main": "tsc --project electron/tsconfig.json",
    "desktop:build": "npm run build:renderer && npm run build:main",
    "check": "tsc --project tsconfig.json --noEmit",
    "check:desktop": "tsc --project electron/tsconfig.json --noEmit",
    "preview": "vite preview",
    "dist": "npm run desktop:build && electron-builder",
    "rebuild:native": "electron-builder install-app-deps"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.18.0",
    "nodemon": "^3.1.14",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.autoecole.app",
    "productName": "Auto Ecole",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Auto-Ecole-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Auto Ecole"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "Office",
      "artifactName": "Auto-Ecole-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "farid-khelil",
      "repo": "auto-ecole",
      "releaseType": "release"
    }
  }
  

}
